#include <iostream>
using namespace std;

int main() {
    int arr[] = {5, 3, 7, 3, 9};
    int x = 3;
    int n = 5;

    int index = -1;

    for (int i = 0; i < n; i++) {
        if (arr[i] == x) {
            index = i;
            break; 
        }
    }

    if (index != -1)
        cout << "Индекс искомого элемента: " << index << endl;
    else
        cout << "Элемент не найден" << endl;

    return 0;
}
