#include <iostream>

using namespace std;

int main ()
{
    int a[3][3];
    int num = 1;
    int sum = 0;

    cout << "Элементы массива:\n";

    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            a[i][j] = num;
            cout << a[i][j] << " ";
            sum += a[i][j];
            num++;
        }
        cout << endl;
    }

    cout << "Сумма элементов " << sum;

    return 0;
}
