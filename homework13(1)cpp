#include <iostream>
#include <stack>
#include <string>
using namespace std;

bool isValid(const string& s) {
    stack<char> st;
    for (char c : s) {
     
        if (c == '(' || c == '[') {
            st.push(c);
        } 
        // Если закрывающая скобка
        else if (c == ')' || c == ']') {
            if (st.empty()) return false;
            if (c == ')' && st.top() != '(') return false;
            if (c == ']' && st.top() != '[') return false;
            st.pop();
        }
    
    }
    return st.empty();
}

int main() {
    string s;
    cout << "Введите строку: ";
    cin >> s;

    if (isValid(s))
        cout << "true\n";
    else
        cout << "false\n";

    return 0;
}
