#include <iostream>

using namespace std;

int main ()
{
float number;

cout <<"Введите число: ";
cin >> number;

if ( number > 0 ) {
    cout << "Число является положительным" ;
}

else if ( number < 0 ) {
    cout << "Число является отрицательным" ;
}

else {
    cout << "Число равно 0";
}

return 0;

}
